# Copy this file to .env and fill in your local PostgreSQL credentials.
# .env is git-ignored and must never be committed.

# ---------------------------------------------------------------------------
# Local PostgreSQL used by Python/dbt
# ---------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=dataflowx
DATABASE_USER=postgres
DATABASE_PASSWORD=changAe_mea

# ---------------------------------------------------------------------------
# Container-to-host PostgreSQL address
# Windows/macOS: host.docker.internal
# Linux: host.docker.internal is mapped to the host gateway by Compose.
# ---------------------------------------------------------------------------
DOCKER_DATABASE_HOST=host.docker.internal

# ---------------------------------------------------------------------------
# Airflow metadata database. Create this database once in your PostgreSQL:
# CREATE DATABASE airflow;
# It is intentionally separate from the DataFlowX application database.
# ---------------------------------------------------------------------------
AIRFLOW_DB_HOST=host.docker.internal
AIRFLOW_DB_PORT=5432
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=postgres
AIRFLOW_DB_PASSWORD=change_me
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_FIRSTNAME=Data
AIRFLOW_ADMIN_LASTNAME=Engineer
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_UID=50000

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
LOG_LEVEL=info
RAW_DATA_DIR=data/raw

# ---------------------------------------------------------------------------
# Product API. The pipeline falls back to data/raw/products.csv if the API
# is unavailable, so a local run does not depend on network availability.
# ---------------------------------------------------------------------------
PRODUCTS_API_BASE_URL=https://fakestoreapi.com
PRODUCTS_API_TIMEOUT_SECONDS=10
